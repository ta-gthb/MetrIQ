      "test_code": "T-WP",
      "name": "Weighing performance",
      "clause_reference": "OIML R 76-1:2006 T.3.1 / A.4.4",
      "category": "metrological",
      "phase": "MVP",
      "sequence_no": 10,
      "implementation_status": "implemented",
      "unsupported_reason": null,
      "clause_reference_status": "provisional",
      "supports_repeated_observations": true,
      "supports_ranges": true,
      "range_scope": "per_range",
      "min_observations": 1,
      "required_capabilities": [],
      "description": "Error of indication determined at loads distributed over the weighing range, compared with the applicable MPE.",
      "applicability_expression": {"always": true},
      "input_schema": {
        "layout": "table",
        "columns": [
          {"key": "range_no", "label": "Range / interval no", "type": "integer", "required": false},
          {"key": "load", "label": "Applied load L", "type": "decimal", "unit": "instrument", "required": true},
          {"key": "indication", "label": "Indication I", "type": "decimal", "unit": "instrument", "required": true},
          {"key": "additional_load", "label": "Additional load to changeover dL", "type": "decimal", "unit": "instrument", "required": false},
          {"key": "unit", "label": "Row unit", "type": "unit", "required": false}
        ],
        "row_label": "Load point"
      },
      "validation_rules": {
        "min_rows": 1,
        "non_negative_fields": ["load", "indication", "additional_load"],
        "required_fields": ["load", "indication"],
        "required_rows": [
          {"load_equals": "0",
           "description": "zero-load reading that establishes E0 for the zero correction"}
        ]
      },
      "calculation_rules": {
        "method": "digital_indication_error",
        "apply_zero_correction": true,
        "require_additional_load": false,
        "round_to_resolution": false
      },
      "compliance_rules": {"comparator": "abs_lte", "limit_source": "mpe"},
      "report_section_mapping": {"section": "tests", "number": "6.1", "title": "Weighing performance"},
