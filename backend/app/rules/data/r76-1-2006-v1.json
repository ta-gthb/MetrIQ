  "tolerances": {
    "zero_return": {
      "factor": "0.5",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-ZR-01",
      "clause_reference": "OIML R 76-1:2006 4.5.4 / T.3.2.1",
      "description": "Deviation of the zero indication after unloading shall not exceed 0.5 e."
    },
    "creep": {
      "factor": "0.5",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-CREEP-01",
      "clause_reference": "OIML R 76-1:2006 4.5.5 / T.3.3",
      "description": "Change in indication under constant load over the observation period."
    },
    "temperature_no_load": {
      "factor": "1.0",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-TEMP-NL-01",
      "clause_reference": "OIML R 76-1:2006 4.5.2 / T.3.4.2",
      "description": "Effect of temperature on the no-load indication."
    },
    "sensitivity": {
      "factor": "1.0",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-SENS-01",
      "clause_reference": "OIML R 76-1:2006 A.4.4.2 / T.3.5",
      "description": "Response of the instrument to a defined change of load."
    },
    "discrimination": {
      "factor": "1.0",
      "unit": "d",
      "comparator": "gte",
      "rule_id": "R76-DISC-01",
      "clause_reference": "OIML R 76-1:2006 4.5.6 / T.3.6",
      "description": "Indication shall change by at least one d for an additional load of 1.4 d."
    },
    "stability": {
      "factor": "1.0",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-STAB-01",
      "clause_reference": "OIML R 76-1:2006 4.5.3 / T.3.7",
      "description": "Variation of the indication during the stability observation period."
    },
    "eccentricity_mpe": {
      "factor": "1.0",
      "unit": "mpe",
      "comparator": "abs_lte",
      "rule_id": "R76-ECC-01",
      "clause_reference": "OIML R 76-1:2006 T.3.5",
      "description": "The eccentricity difference is compared against the MPE for the applied load."
    },
    "tilt": {
      "factor": "1.0",
      "unit": "mpe",
      "comparator": "abs_lte",
      "rule_id": "R76-TILT-01",
      "clause_reference": "OIML R 76-1:2006 4.4.4 / T.3.6",
      "basis": "The instrument must meet its MPE when it is tilted away from its reference position, so the change of indication caused by tilting is compared with the MPE that applies to the applied load.",
      "description": "Change of indication caused by tilting the instrument away from its reference position."
    },
    "tare": {
      "factor": "0.5",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-TARE-01",
      "clause_reference": "OIML R 76-1:2006 4.6.4 / T.3.13",
      "basis": "With a subtractive tare engaged the instrument must indicate zero, and the net indication of a load applied afterwards must agree with that load; both are the error of indication of the tared reading, held to 0.5 e.",
      "description": "Error of indication of the tared reading with a subtractive tare device."
    },
    "warmup": {
      "factor": "1.0",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-WARMUP-01",
      "clause_reference": "OIML R 76-1:2006 4.4.2 / T.3.8",
      "basis": "Drift of the indication between power-on and the end of the manufacturer's warm-up period, held to 1 e.",
      "description": "Drift of the indication between power-on and the end of the warm-up period."
    },
    "voltage_variation": {
      "factor": "1.0",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-VOLT-01",
      "clause_reference": "OIML R 76-1:2006 4.4.3 / T.3.9",
      "basis": "Change of indication between the nominal supply and each disturbed supply condition (variation, dip, short interruption), held to 1 e.",
      "description": "Effect of mains voltage variation, voltage dips and short interruptions."
    },
    "emc_immunity": {
      "factor": "1.0",
      "unit": "e",
      "comparator": "abs_lte",
      "rule_id": "R76-EMC-01",
      "clause_reference": "OIML R 76-1:2006 4.4.5 / T.3.10",
      "basis": "Change of indication attributable to the applied disturbance, measured against the reading taken immediately before it, held to 1 e.",
      "description": "Effect of electrical bursts, surges, electrostatic discharge and radio-frequency fields."
    },
    "damp_heat": {
      "factor": "1.0",
      "unit": "mpe",
      "comparator": "abs_lte",
      "rule_id": "R76-DAMP-01",
      "clause_reference": "OIML R 76-1:2006 4.4.6 / T.3.11",
      "basis": "After damp-heat conditioning the instrument must meet its MPE again, so the change of indication is compared with the MPE that applies to the applied load.",
      "description": "Effect of damp heat, span stability and repeated loading."
    }
  }
