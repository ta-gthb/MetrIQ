# MetrIQ configuration. Copy to .env for local development.
# Every value below has a safe development default except the production secrets.

# --- Core -------------------------------------------------------------------
APP_NAME=MetrIQ
ENVIRONMENT=development
DEBUG=true

# --- Bootstrap --------------------------------------------------------------
# A deployed instance has no release step on Render's free plan, so it creates
# missing tables and seeds roles/rules/catalogue as it boots. Both are
# idempotent; the seeding step is skipped once the data is present.
AUTO_INIT_DB=true
AUTO_SEED_REFERENCE=true
API_V1_PREFIX=/api/v1

# --- Database ---------------------------------------------------------------
# Development: SQLite needs no server. Production: the Supabase connection
# session pooler URL, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./metriq.db
SQL_ECHO=false
# PostgreSQL schema for MetrIQ's tables. Leave empty for the default (`public`,
# or the SQLite file). Set it when the database is shared with another
# application whose tables would collide - name clashes such as `users` are
# then impossible, and public is left untouched.
DB_SCHEMA=

# --- Authentication ---------------------------------------------------------
# supabase | local | hybrid. Chooses which identity providers may sign in:
#   hybrid   - Supabase tokens and MetrIQ's own sessions (the default)
#   supabase - Supabase tokens only
#   local    - refuses Supabase sign-in entirely
# MetrIQ's own session token is always accepted, because the API mints one in
# every case: after a Supabase sign-in it exchanges the provider's token at
# /auth/session for one. Local *passwords* are governed by DEMO_MODE below.
AUTH_PROVIDER=hybrid
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated
# Short on purpose: the frontend refreshes a 401 once (audit item 13).
ACCESS_TOKEN_TTL_MINUTES=60
# Rotated on every use, and kept in an HttpOnly cookie rather than page storage.
REFRESH_TOKEN_TTL_DAYS=14

# Supabase project. The JWKS endpoint and the expected token issuer are derived
# from the project URL, so a project on asymmetric signing keys needs only the
# first two. In production this is the identity provider (audit item 4).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
# Only for a project still signing with the legacy HS256 shared secret.
SUPABASE_JWT_SECRET=
# Only when `iss` is not <SUPABASE_URL>/auth/v1, e.g. on a custom domain.
SUPABASE_JWT_ISSUER=

# --- Storage ----------------------------------------------------------------
# local | supabase. With `supabase`, evidence AND generated report artefacts are
# written to the bucket below, so the host needs no durable local disk.
STORAGE_BACKEND=local
STORAGE_BUCKET=metriq-evidence
STORAGE_LOCAL_PATH=./var/storage
# Legacy: only consulted when reading a report row that holds an absolute path.
REPORT_STORAGE_PATH=./var/reports
MAX_UPLOAD_BYTES=26214400
SIGNED_URL_TTL_SECONDS=900
# Photographic evidence that must be attached before a case can be submitted
# for technical review. Comma-separated attachment categories.
REQUIRED_EVIDENCE_CATEGORIES=nameplate_photograph,test_setup_photograph

# --- AI ---------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=stub
AI_VISION_MODEL=gpt-4o-mini
AI_TEXT_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MIN_CONFIDENCE=0.75

# --- Reporting --------------------------------------------------------------
REPORT_LABORATORY_NAME=MetrIQ Regional Legal Metrology Laboratory
REPORT_LABORATORY_CODE=LAB-001
# The deployed frontend origin, e.g. https://metriq.vercel.app. A report
# then carries a QR code that opens /verification.html?code=... and the
# verification page answers from GET /api/v1/verify/{code}. Left empty,
# reports are rendered without the mark. The address is deployment
# metadata: it never changes a report's content hash or code.
PUBLIC_APP_URL=

# --- CORS -------------------------------------------------------------------
# Exact browser origins allowed to call the API, comma-separated, no trailing
# slash. Localhost entries are ignored in production, and the frontend on Vercel
# reaches the API through a same-origin rewrite (vercel.json), so a deployment
# normally needs nothing here.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:3000
# Exact-origin regexes only. A wildcard (for example https://.*\.vercel\.app) is
# refused at start-up: with credentials it would let any deployment of that host
# call the API. List the real origins in CORS_ORIGINS instead.
CORS_ALLOW_ORIGIN_REGEX=

# --- Demonstration mode -----------------------------------------------------
# Demo sign-in for the seeded accounts. The login page carries no credential: it
# asks /auth/demo-accounts, which answers only while DEMO_MODE is on, and labels
# the panel "Demo mode" when it does. DEMO_PASSWORD is what seed_db.py hashes, so
# rotating it rotates the seeded accounts and the panel together. Leave DEMO_MODE
# off for a real deployment, which then exposes no demonstration credential.
DEMO_MODE=false
DEMO_PASSWORD=MetrIQ@2026