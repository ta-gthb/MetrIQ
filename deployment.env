# Non-secret deployment defaults, committed on purpose.
#
# This file lets a deployed MetrIQ service pick up values that are not secrets
# without anyone opening a hosting dashboard. It is read by app.config before
# .env, and real environment variables always win over it - so setting
# DB_SCHEMA on Render, or in a local .env, still overrides what is here.
#
# Never put a password, key or token in this file. Secrets belong in the
# hosting platform's environment, or in the gitignored .env.

# MetrIQ's tables live in a dedicated schema on this deployment. The Supabase
# project is shared with another application that owns `public`, including a
# `users` table whose columns do not match MetrIQ's, so resolving unqualified
# names against public fails with "column users.role_code does not exist".
#
# Ignored on SQLite, which has no schemas, so local development is unaffected.
DB_SCHEMA=metriq

# Whether start-up creates missing tables and seeds roles/rules/catalogue.
# Both are idempotent, and the free Render plan provides no release step.
AUTO_INIT_DB=true
AUTO_SEED_REFERENCE=true